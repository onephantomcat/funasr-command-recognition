{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tse_prediction.schema.json",
  "title": "TSE 逐条预测记录（P2-11 手册口径）",
  "type": "object",
  "required": [
    "sample_id", "scenario", "target_present", "checkpoint_sha256",
    "data_sha256", "sisdr", "sisdri", "energy_ratio", "activity_mean",
    "nan", "clipped", "latency_ms"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "scenario": {"type": "string"},
    "target_present": {"type": "boolean"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sisdr": {"type": ["number", "null"], "description": "PRESENT 专用；ABSENT 为 null（禁止 SI-SDR）"},
    "sisdri": {"type": ["number", "null"]},
    "energy_ratio": {"type": "number", "description": "||est||^2/(||mix||^2+eps)；ABSENT 时即 rho_abs"},
    "activity_mean": {"type": "number", "description": "p_tgt 帧均值；ABSENT 诊断用"},
    "nan": {"type": "boolean"},
    "clipped": {"type": "boolean"},
    "latency_ms": {"type": "number"}
  },
  "additionalProperties": false
}